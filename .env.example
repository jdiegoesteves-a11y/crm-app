# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — CRM EXECUTIVE DARK 2.0
# Copie este archivo como .env.local para su configuración personal
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development

# Clave secreta para firma de cookies JWT internas (obligatorio para sesiones locales seguras)
JWT_SECRET=executive_dark_jwt_secret_key_minimum_32_characters_long_987654321

# Configuración de Supabase (Opcional durante desarrollo local; obligatorio para producción)
# Obtenga estas variables en el panel de Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configuración regional predeterminada
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Guayaquil

# ==============================================================================
# INTEGRACIÓN OFICIAL INSTAGRAM DIRECT MESSAGING (Meta for Developers)
# ==============================================================================
# App Name: CRM Executive-IG | App ID: 110721452239193
INSTAGRAM_APP_ID=110721452239193
# Clave secreta de la aplicación (Obtenga en Meta for Developers > Configuración > Básica)
INSTAGRAM_APP_SECRET=
# Token de verificación para el webhook (configurar idéntico en Meta Developers)
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=crm_executive_ig_verify_token_2026_secure
# URL base de la aplicación para callbacks (ej. http://localhost:3000 o https://su-dominio.com)
APP_BASE_URL=http://localhost:3000
